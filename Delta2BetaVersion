-- Script File Tab Management Logic
local tabs = {}
local activeTab = nil

local function switchTab(tabData)
    if activeTab then
        activeTab.content = editor.Text
        activeTab.button.BackgroundColor3 = Color3.fromRGB(20, 16, 28)
        activeTab.button.TextColor3 = Color3.fromRGB(150, 140, 170)
    end
    activeTab = tabData
    editor.Text = tabData.content
    tabData.button.BackgroundColor3 = Color3.fromRGB(32, 24, 45)
    tabData.button.TextColor3 = white
end

local function createTab(customName, customContent)
    local tabCount = 0 for _ in pairs(tabs) do tabCount = tabCount + 1 end
    local tabData = {}
    tabData.name = customName or ("Script " .. (tabCount + 1))
    tabData.content = customContent or ""
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(115, 26)
    btn.BackgroundColor3 = Color3.fromRGB(20, 16, 28)
    btn.Text = "   " .. tabData.name
    btn.TextColor3 = Color3.fromRGB(150, 140, 170)
    btn.TextSize = 10
    btn.Font = Enum.Font.GothamMedium
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = scriptSubBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    
    tabData.button = btn
    tabs[tabData] = true
    
    local closeTabBtn = Instance.new("TextButton")
    closeTabBtn.Size = UDim2.fromOffset(16, 16)
    closeTabBtn.Position = UDim2.new(1, -18, 0.5, -8)
    closeTabBtn.BackgroundTransparency = 1
    closeTabBtn.Text = "×"
    closeTabBtn.TextColor3 = Color3.fromRGB(150, 140, 170)
    closeTabBtn.TextSize = 12
    closeTabBtn.Font = Enum.Font.GothamBold
    closeTabBtn.Parent = btn

    btn.MouseButton1Click:Connect(function() switchTab(tabData) end)
    
    closeTabBtn.MouseButton1Click:Connect(function()
        local count = 0 for _ in pairs(tabs) do count = count + 1 end
        if count > 1 then
            btn:Destroy()
            tabs[tabData] = nil
            if activeTab == tabData then
                for nextTab in pairs(tabs) do switchTab(nextTab) break end
            end
        end
    end)
    
    switchTab(tabData)
end

