local currentStepIndex = 1

local function updateStepDisplay()
    local stepData = curriculum[currentStepIndex]
    stepTitle.Text = "Step " .. currentStepIndex .. "/10: " .. stepData.t
    stepDesc.Text = stepData.d
    codePreviewBox.Text = stepData.c
end

nextStepBtn.MouseButton1Click:Connect(function()
    if currentStepIndex < #curriculum then
        currentStepIndex = currentStepIndex + 1
        updateStepDisplay()
    end
end)

prevStepBtn.MouseButton1Click:Connect(function()
    if currentStepIndex > 1 then
        currentStepIndex = currentStepIndex - 1
        updateStepDisplay()
    end
end)


