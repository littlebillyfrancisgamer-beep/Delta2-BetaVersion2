            Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

            local nameLabel = Instance.new("TextLabel")
            nameLabel.Position = UDim2.fromOffset(10, 6)
            nameLabel.Size = UDim2.new(1, -160, 0, 24)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = scriptData.title
            nameLabel.TextColor3 = white
            nameLabel.TextSize = 11
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.TextWrapped = true
            nameLabel.Parent = card

            local infoLabel = Instance.new("TextLabel")
            infoLabel.Position = UDim2.fromOffset(10, 32)
            infoLabel.Size = UDim2.new(1, -160, 0, 14)
            infoLabel.BackgroundTransparency = 1
            infoLabel.Text = scriptData.source .. " • " .. scriptData.views .. " Views"
            infoLabel.TextColor3 = Color3.fromRGB(140, 130, 160)
            infoLabel.TextSize = 9
            infoLabel.Font = Enum.Font.Gotham
            infoLabel.TextXAlignment = Enum.TextXAlignment.Left
            infoLabel.Parent = card

            local viewBtn = Instance.new("TextButton")
            viewBtn.Position = UDim2.new(1, -156, 1, -26)
            viewBtn.Size = UDim2.new(0, 48, 0, 20)
            viewBtn.BackgroundColor3 = Color3.fromRGB(28, 22, 38)
            viewBtn.Text = "View"
            viewBtn.TextColor3 = white
            viewBtn.TextSize = 9
            viewBtn.Font = Enum.Font.GothamBold
            viewBtn.Parent = card
            Instance.new("UICorner", viewBtn).CornerRadius = UDim.new(0, 4)

            local editBtn = Instance.new("TextButton")
            editBtn.Position = UDim2.new(1, -104, 1, -26)
            editBtn.Size = UDim2.new(0, 48, 0, 20)
            editBtn.BackgroundColor3 = Color3.fromRGB(45, 35, 60)
            editBtn.Text = "Edit"
            editBtn.TextColor3 = white
            editBtn.TextSize = 9
            editBtn.Font = Enum.Font.GothamBold
            editBtn.Parent = card
            Instance.new("UICorner", editBtn).CornerRadius = UDim.new(0, 4)

            local runBtn = Instance.new("TextButton")
            runBtn.Position = UDim2.new(1, -52, 1, -26)
            runBtn.Size = UDim2.new(0, 46, 0, 20)
            runBtn.BackgroundColor3 = accent
            runBtn.Text = "Run"
            runBtn.TextColor3 = white
            runBtn.TextSize = 9
            runBtn.Font = Enum.Font.GothamBold
            runBtn.Parent = card
            Instance.new("UICorner", runBtn).CornerRadius = UDim.new(0, 4)

            viewBtn.MouseButton1Click:Connect(function()
                modalTitle.Text = scriptData.title
                modalCodeBox.Text = scriptData.code
                modalOverlay.Visible = true
            end)

            editBtn.MouseButton1Click:Connect(function()
                createTab(scriptData.title, scriptData.code)
                hubPage.Visible = false
                editorPage.Visible = true
                status.Text = "Loaded script into editor tab."
            end)

            runBtn.MouseButton1Click:Connect(function()
                createTab(scriptData.title, scriptData.code)
                pcall(function() loadstring(scriptData.code)() end)
                status.Text = "Executed hub script successfully."
            end)
        end
    end)
end

