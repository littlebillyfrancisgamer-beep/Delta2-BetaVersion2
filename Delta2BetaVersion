-- Combined Script Source Search API
local function searchAllHubs(query)
    for _, child in ipairs(resultsScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    if query == "" then return end
    status.Text = "Searching for: " .. query .. "..."

    task.spawn(function()
        local reqFunc = (syn and syn.request) or request or http_request or (fluxus and fluxus.request)
        local totalScripts = {}

        -- 1. ScriptBlox
        local sbURL = "https://scriptblox.com/api/script/search?q=" .. HttpService:UrlEncode(query)
        local sbSuccess, sbBody = pcall(function()
            if reqFunc then
                local res = reqFunc({Url = sbURL, Method = "GET"})
                if res and res.Body then return HttpService:JSONDecode(res.Body) end
            end
            return HttpService:JSONDecode(game:HttpGet(sbURL))
        end)

        if sbSuccess and sbBody and sbBody.result and sbBody.result.scripts then
            for _, s in ipairs(sbBody.result.scripts) do
                table.insert(totalScripts, {
                    title = s.title or "Untitled",
                    source = "ScriptBlox",
                    views = tostring(s.views or "0"),
                    verified = s.verified or s.isVerified or false,
                    code = s.script or s.rawScript or s.code or "-- No source code."
                })
            end
        end

        -- 2. RobloxScripts
        local rsURL = "https://rscripts.net/api/scripts?q=" .. HttpService:UrlEncode(query)
        local rsSuccess, rsBody = pcall(function()
            if reqFunc then
                local res = reqFunc({Url = rsURL, Method = "GET"})
                if res and res.Body then return HttpService:JSONDecode(res.Body) end
            end
            return HttpService:JSONDecode(game:HttpGet(rsURL))
        end)

        if rsSuccess and rsBody then
            local list = rsBody.scripts or rsBody.result or rsBody
            if type(list) == "table" then
                for _, s in ipairs(list) do
                    table.insert(totalScripts, {
                        title = s.title or s.name or "Untitled",
                        source = "RobloxScripts",
                        views = tostring(s.views or s.downloads or "0"),
                        verified = s.verified or false,
                        code = s.script or s.loadstring or s.code or "-- No source code."
                    })
                end
            end
        end

        status.Text = "Found " .. #totalScripts .. " matching scripts."

        for _, scriptData in ipairs(totalScripts) do
            local card = Instance.new("Frame")
            card.Size = UDim2.new(1, 0, 0, 60)
            card.BackgroundColor3 = Color3.fromRGB(18, 14, 24)
            card.BorderSizePixel = 0
