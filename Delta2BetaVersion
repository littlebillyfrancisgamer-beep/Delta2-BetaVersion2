local function createSettingToggle(titleText, descText, callback)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 50)
    card.BackgroundColor3 = Color3.fromRGB(14, 11, 20)
    card.BorderSizePixel = 0
    card.Parent = settingsScroll
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)
    
    local str = Instance.new("UIStroke")
    str.Color = Color3.fromRGB(45, 35, 60)
    str.Parent = card

    local tLbl = Instance.new("TextLabel")
    tLbl.Position = UDim2.fromOffset(12, 8)
    tLbl.Size = UDim2.new(1, -70, 0, 18)
    tLbl.BackgroundTransparency = 1
    tLbl.Text = titleText
    tLbl.TextColor3 = white
    tLbl.TextSize = 12
    tLbl.Font = Enum.Font.GothamBold
    tLbl.TextXAlignment = Enum.TextXAlignment.Left
    tLbl.Parent = card

    local dLbl = Instance.new("TextLabel")
    dLbl.Position = UDim2.fromOffset(12, 26)
    dLbl.Size = UDim2.new(1, -70, 0, 16)
    dLbl.BackgroundTransparency = 1
    dLbl.Text = descText
    dLbl.TextColor3 = Color3.fromRGB(140, 130, 160)
    dLbl.TextSize = 10
    dLbl.Font = Enum.Font.Gotham
    dLbl.TextXAlignment = Enum.TextXAlignment.Left
    dLbl.Parent = card

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Position = UDim2.new(1, -52, 0.5, -12)
    toggleBtn.Size = UDim2.fromOffset(40, 24)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(28, 22, 38)
    toggleBtn.Text = "OFF"
    toggleBtn.TextColor3 = Color3.fromRGB(160, 150, 180)
    toggleBtn.TextSize = 10
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.Parent = card
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 4)

    local state = false
    toggleBtn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            toggleBtn.BackgroundColor3 = accent
            toggleBtn.TextColor3 = white
            toggleBtn.Text = "ON"
        else
            toggleBtn.BackgroundColor3 = Color3.fromRGB(28, 22, 38)
            toggleBtn.TextColor3 = Color3.fromRGB(160, 150, 180)
            toggleBtn.Text = "OFF"
        end
        if callback then callback(state) end
    end)
end

